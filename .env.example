# Kopieren nach ".env" und mit echten, eigenen Werten fuellen - .env NICHT
# einchecken (steht in .gitignore). Ohne .env mit allen drei Werten startet
# der Server bewusst nicht (siehe server.js).

# Admin-Zugang zur Verwaltung. Danach auch jederzeit in der App selbst unter
# Verwaltung > Zugangsdaten aenderbar.
ADMIN_CODE=change-me-admin-code

# Token, mit dem sich Familien einmalig einen eigenen Account anlegen.
FAMILY_TOKEN=change-me-family-token

# Langer, zufaelliger Text zum Signieren der Session-Cookies. Einmalig
# festlegen und danach nie mehr aendern - sonst werden bei jedem Neustart
# alle Logins ungueltig. Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
